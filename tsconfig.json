{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "composite": true
  },
  "references": [
    { "path": "packages/@keyspot/patterns" },
    { "path": "packages/@keyspot/vault" },
    { "path": "packages/@keyspot/core" },
    { "path": "packages/@keyspot/adapters" },
    { "path": "packages/@keyspot/cli" },
    { "path": "packages/@keyspot/frameworks" },
    { "path": "packages/@keyspot/server" },
    { "path": "packages/keyspot-agent" },
    { "path": "packages/keyspot-sdk" },
    { "path": "packages/@keyspot/mcp" },
    { "path": "packages/@keyspot/native" }
  ]
}
