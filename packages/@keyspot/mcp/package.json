{
  "name": "@roadsidelab/keyspot-mcp",
  "version": "0.0.5",
  "description": "KeySpot MCP server — runtime credential hygiene via Model Context Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.dts",
  "bin": {
    "keyspot-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.dts",
      "import": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "import": "./dist/prompts.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@roadsidelab/keyspot-core": "workspace:*",
    "@roadsidelab/keyspot-vault": "workspace:*",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roadsidedev/keyspot-sdk",
    "directory": "packages/@keyspot/mcp"
  },
  "keywords": ["keyspot", "mcp", "model-context-protocol", "secret-scanner", "ai-security"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
